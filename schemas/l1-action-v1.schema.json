{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bedwars-arena.invalid/schemas/l1-action-v1.schema.json",
  "title": "L1 action envelope v1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "match_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "player_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "decision_round_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "observed_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "life_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "requests": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "kind": {
                "const": "turn"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "z"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "request_id",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "kind": {
                "const": "select_item"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "enum": [
                      "iron",
                      "wool",
                      "wooden_sword",
                      "iron_sword",
                      "shears"
                    ]
                  }
                },
                "required": [
                  "item"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "request_id",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "kind": {
                "const": "move"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "z"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "request_id",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "kind": {
                "const": "attack"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "player_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001f]+$"
                  },
                  "life_index": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "player_id",
                  "life_index"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "request_id",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "kind": {
                "const": "break_block"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "z": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "layer": {
                    "type": "string",
                    "enum": [
                      "bridge",
                      "wall"
                    ]
                  },
                  "instance_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001f]+$"
                  }
                },
                "required": [
                  "x",
                  "z",
                  "layer",
                  "instance_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "request_id",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "kind": {
                "const": "break_bed"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "team_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001f]+$"
                  }
                },
                "required": [
                  "team_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "request_id",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "kind": {
                "const": "place_block"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "z": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "layer": {
                    "type": "string",
                    "enum": [
                      "bridge",
                      "wall"
                    ]
                  }
                },
                "required": [
                  "x",
                  "z",
                  "layer"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "request_id",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "kind": {
                "const": "cancel"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "channel": {
                    "type": "string",
                    "enum": [
                      "movement",
                      "interaction"
                    ]
                  }
                },
                "required": [
                  "channel"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "request_id",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "kind": {
                "const": "buy"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "product": {
                    "type": "string",
                    "enum": [
                      "wool",
                      "iron_sword",
                      "armor_1"
                    ]
                  }
                },
                "required": [
                  "product"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "request_id",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "kind": {
                "const": "drop_resource"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "resource": {
                    "type": "string",
                    "enum": [
                      "iron"
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "resource",
                  "quantity"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "request_id",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "protocol_version",
    "match_id",
    "player_id",
    "decision_round_id",
    "observed_tick",
    "life_index",
    "requests"
  ],
  "additionalProperties": false
}
