{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bedwars-arena.invalid/schemas/l1-map-v1.schema.json",
  "title": "BedWars Arena L1 map format v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "map_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "map_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "bounds": {
      "type": "object",
      "properties": {
        "min_x": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "max_x": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "min_z": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "max_z": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min_x",
        "max_x",
        "min_z",
        "max_z"
      ],
      "additionalProperties": false
    },
    "terrain": {
      "type": "object",
      "properties": {
        "original_island_y": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "bridge_y": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "wall_y": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "islands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "bounds": {
                "type": "object",
                "properties": {
                  "min_x": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "max_x": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "min_z": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "max_z": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "min_x",
                  "max_x",
                  "min_z",
                  "max_z"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "bounds"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "original_island_y",
        "bridge_y",
        "wall_y",
        "islands"
      ],
      "additionalProperties": false
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "team_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "spawn": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "z"
            ],
            "additionalProperties": false
          },
          "facing": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "z"
            ],
            "additionalProperties": false
          },
          "bed": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "z": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "z"
            ],
            "additionalProperties": false
          },
          "shop": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "team_id",
          "spawn",
          "facing",
          "bed",
          "shop"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "generators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "generator_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "team_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "generator_id",
          "kind",
          "team_id",
          "position"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "protected_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "bounds": {
            "type": "object",
            "properties": {
              "min_x": {
                "type": "number"
              },
              "max_x": {
                "type": "number"
              },
              "min_z": {
                "type": "number"
              },
              "max_z": {
                "type": "number"
              }
            },
            "required": [
              "min_x",
              "max_x",
              "min_z",
              "max_z"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "target_id",
          "bounds"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "map_id",
    "map_version",
    "bounds",
    "terrain",
    "teams",
    "generators",
    "protected_regions"
  ],
  "additionalProperties": false
}
