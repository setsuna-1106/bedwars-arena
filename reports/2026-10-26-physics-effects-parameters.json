    {
      "id": "D01",
      "description": "Arena first-full-period + half-open expiry produces pulses at 25/50/75 for a 100-tick Regeneration II grant: 3 HP before caps. Do not claim vanilla/Hypixel 4-HP equivalence or secretly lengthen duration."
    },
    {
      "id": "D02",
      "description": "Arena instant active movement uses steady native-like ground speed; native active inertia/diagonal details are not imported."
    },
    {
      "id": "D03",
      "description": "Arena independent dominant knockback and source clock/zone refresh policies are adopted simulation choices, not verified server algorithms."
    },
    {
      "id": "D04",
      "description": "A support loss is same-tick void death and A blindness uses a radius adaptation; B remains separate."
    }
  ]
